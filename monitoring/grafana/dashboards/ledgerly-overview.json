{
  "uid": "ledgerly-day12",
  "title": "Ledgerly - Reliability and Event Delivery",
  "tags": ["ledgerly", "payments", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ledger Core UP",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "up{job=\"ledger-core\"}"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Payment Service UP",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "up{job=\"payment-service\"}"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ledger Outbox Pending Events",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "ledger_outbox_pending"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Payment Outbox Pending Events",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "payments_outbox_pending"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Oldest Ledger Event Age (seconds)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "ledger_outbox_oldest_pending_age_seconds"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oldest Payment Event Age (seconds)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "payments_outbox_oldest_pending_age_seconds"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dead Letters - 5m",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(payments_events_dead_lettered_total[5m])) or vector(0)"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Payment / Ledger Inconsistencies - 5m",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(payments_events_inconsistent_total[5m])) or vector(0)"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reconciliation Fallbacks - 5m",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(payments_reconciliation_settled_total[5m])) or vector(0)"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP Requests per Second",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Average HTTP Latency (seconds)",
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_sum[5m])) / clamp_min(sum by (job) (rate(http_server_requests_seconds_count[5m])), 0.001)"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Kafka Consumer Progress",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumer Backlog (retained offsets)",
      "description": "Distance from committed group offsets to partition ends, summed within each topic. Missing commits start at the earliest retained offset. This approximates backlog, not an exact event count. Maximum across sampler replicas avoids double-counting; unknown samples remain gaps.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (group, topic) (payments_kafka_consumer_lag)",
          "legendFormat": "{{group}} / {{topic}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Largest Partition Backlog (offsets)",
      "description": "Largest retained offset distance among partitions in a topic; a large value can reveal one stalled partition. Uses committed offsets, not listener position. Maximum across sampler replicas avoids double-counting. Unknown samples remain gaps.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (group, topic) (payments_kafka_consumer_lag_max)",
          "legendFormat": "{{group}} / {{topic}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Lag Sample Health",
      "description": "Per sampler instance: 1 means a successful sample no older than 60 seconds; 0 means startup, failure or stale data. Check each instance because a healthy replica can still supply topic lag while another sampler fails. Missing data is Unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "payments_kafka_lag_sample_success",
          "legendFormat": "{{group}} / {{instance}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Last Successful Sample Age",
      "description": "Seconds since each sampler instance last completed a successful sample, or since monitor startup if none has completed. Samples older than 60 seconds are stale and topic gauges become unknown. A young age alone does not imply success; also check sample health.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 53,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "payments_kafka_lag_sample_age_seconds",
          "legendFormat": "{{group}} / {{instance}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Partitions Without Committed Offsets",
      "description": "Partitions with no committed group offset. Their backlog starts at the earliest retained offset, matching the configured earliest reset policy. This can be expected for a new group; unknown sampler data remains Unknown. Maximum across replicas avoids double-counting.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 53,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (group, topic) (payments_kafka_consumer_uncommitted_partitions)",
          "legendFormat": "{{group}} / {{topic}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Invalid Committed Offsets",
      "description": "Partitions whose committed offset is outside the retained earliest-to-latest range. Any invalid offset makes that topic backlog unknown. Investigate retention, topic recreation or offset resets. Maximum across replicas avoids double-counting.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (group, topic) (payments_kafka_consumer_invalid_offsets)",
          "legendFormat": "{{group}} / {{topic}}"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Lag Sampling Failures - 5m",
      "description": "Failed sampling attempts over five minutes, separately for each payment-service instance. A blocked or stale sampler may have no new failure yet, so also inspect sample health and age. Missing data is not replaced with zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "ledgerly-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 58,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(payments_kafka_lag_sample_failures_total[5m])",
          "legendFormat": "{{group}} / {{instance}}"
        }
      ]
    }
  ]
}
