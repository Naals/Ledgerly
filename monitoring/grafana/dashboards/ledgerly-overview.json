{
  "uid": "ledgerly-day12",
  "title": "Ledgerly - Reliability and Event Delivery",
  "tags": ["ledgerly", "payments", "observability"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ledger Core UP",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "up{job=\"ledger-core\"}"}
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Payment Service UP",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "up{job=\"payment-service\"}"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ledger Outbox Pending Events",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "ledger_outbox_pending"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Payment Outbox Pending Events",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "payments_outbox_pending"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Oldest Ledger Event Age (seconds)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "ledger_outbox_oldest_pending_age_seconds"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oldest Payment Event Age (seconds)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "payments_outbox_oldest_pending_age_seconds"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Dead Letters - 5m",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(payments_events_dead_lettered_total[5m])) or vector(0)"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Payment / Ledger Inconsistencies - 5m",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(payments_events_inconsistent_total[5m])) or vector(0)"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reconciliation Fallbacks - 5m",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(payments_reconciliation_settled_total[5m])) or vector(0)"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "HTTP Requests per Second",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))"}
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Average HTTP Latency (seconds)",
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ledgerly-prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_sum[5m])) / clamp_min(sum by (job) (rate(http_server_requests_seconds_count[5m])), 0.001)"
        }
      ]
    }
  ]
}